  "separate_review_plan": {
    "purpose": "Broader-data convergent check: can one set of reviews identify direct unavailability reports by different applicants? This is distinct from Lourie attenuation and not a replacement for its results.",
    "data": "Same fully classified company-years and existing labels; no additional API calls.",
    "split": "One fixed partition, seed 20261101; SHA256 of seed and normalized-text hash. Identical text stays in one group globally, including across companies. Both A-to-B and B-to-A directions retained.",
    "scores": [
      "Original broad raw share among all training reviews",
      "Communication-only disjoint category share among all training reviews"
    ],
    "evaluation": "Company-years with >=10 training reviews and >=5 heldout no-offer reviews. Target is direct unavailable-role reports, features 1,2,3,4, in heldout no-offer reviews. Higher/lower groups split at training-score median within eligible company-years, never selected by target outcomes.",
    "models": [
      "Review-weighted unadjusted group gap",
      "Year/industry-adjusted gap",
      "Within-company/year gap"
    ],
    "uncertainty": "Company-clustered t inference; Holm across all 12 model comparisons. 1999 whole-company bootstrap draws for the raw gaps, fixed score-group assignments.",
    "limits": "Automated common-platform narrative consistency, not independent vacancy status or classification accuracy. A single partition in an already explored dataset is not untouched confirmation."
